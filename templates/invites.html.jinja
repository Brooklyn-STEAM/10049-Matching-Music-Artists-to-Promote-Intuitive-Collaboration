<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <title>Backstage - Invites</title>
</head>
<body class="bg-[#F5EEDD] text-[#06202B] font-sans antialiased min-h-screen flex flex-col">

    {% include "components/navbar.html.jinja" %}

    <main class="flex-1 container mx-auto px-4 py-12">
        <h1 class="text-center font-bold text-4xl mb-10">Collaboration Invites</h1>

        <div class="max-w-2xl mx-auto space-y-6">
            {% if Invites_sent_to_user %}
                {% for invite in Invites_sent_to_user %}
                <div class="bg-white rounded-2xl p-6 shadow-md border border-gray-200 hover:shadow-lg transition-all">
                    
                    <div class="flex items-center gap-4 mb-4">
                        <a href="/view_profile/{{ invite.User_ID }}" class="w-16 h-16 rounded-full overflow-hidden border-2 border-[#077A7D] block hover:opacity-80 transition-opacity">
                            <img 
                                src="{{ url_for('static', filename='uploads/' + invite.Profile_picture) if invite.Profile_picture != 'default' else '/static/profile.jpg' }}" 
                                class="w-full h-full object-cover"
                                alt="Profile Picture"
                            >
                        </a>
                        <div>
                            <h2 class="font-bold text-lg hover:text-[#077A7D] transition-colors">
                                <a href="/view_profile/{{ invite.User_ID }}">{{ invite.Profile_name }}</a>
                            </h2>
                            <p class="text-sm text-gray-500">{{ invite.email }}</p>
                        </div>
                        
                        <div class="ml-auto">
                            <a href="/view_profile/{{ invite.User_ID }}" class="text-xs bg-gray-100 text-gray-600 font-semibold px-3 py-1 rounded-full hover:bg-[#077A7D] hover:text-white transition-all">
                                View Profile →
                            </a>
                        </div>
                    </div>

                    {% if invite.songs %}
                    <div class="mb-4">
                        <h3 class="font-bold text-sm text-gray-700 mb-2">Songs:</h3>
                        <div class="space-y-2">
                            {% for song in invite.songs %}
                            <div class="flex items-center gap-3">
                                <p class="text-sm text-gray-800 flex-1">{{ song.Song_name }}</p>
                                <audio controls class="w-full">
                                    <source src="{{ url_for('static', filename='uploads/' + song.Song_file) }}" type="audio/mpeg">
                                    Your browser does not support the audio element.
                                </audio>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}

                    <div class="flex gap-4 border-t pt-4 mt-2">
                        <form action="/invites/{{ invite.User_ID }}/decline" method="POST">
                            <button type="submit" class="px-4 py-2 rounded-full border-2 border-gray-300 text-gray-600 font-bold text-sm hover:bg-gray-100 transition-all">
                                Decline
                            </button>
                        </form>

                        <form action="/invites/{{ invite.User_ID }}/accept" method="POST">
                            <button type="submit" class="px-6 py-2 rounded-full bg-[#077A7D] text-white font-bold text-sm hover:bg-[#055a5c] transition-all shadow-sm">
                                Accept
                            </button>
                        </form>
                    </div>
                </div>
                {% endfor %}
            {% else %}
                <div class="text-center py-20 bg-white/50 rounded-3xl border-2 border-dashed border-gray-300">
                    <p class="text-gray-500 font-medium">No pending invites at the moment.</p>
                    <a href="/matching" class="text-[#077A7D] font-bold mt-2 inline-block hover:underline">Go find collaborators →</a>
                </div>
            {% endif %}
        </div>
    </main>

</body>
</html>