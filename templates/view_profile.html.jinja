<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <title>Backstage - {{ Profile.Profile_name }}'s Profile</title>
  <style>
    
    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    .animate-spin-slow {
      animation: spin 6s linear infinite;
    }
  </style>
</head>
<body class="bg-[#F5EEDD] text-[#06202B] font-sans antialiased min-h-screen flex flex-col">

    {% include "components/navbar.html.jinja" %}

    <main class="flex-1 container mx-auto px-4 py-12">
        <div class="max-w-3xl mx-auto mb-6">
            <a href="/invites" class="inline-flex items-center text-sm font-bold text-[#077A7D] hover:underline">
                ← Back to Invites
            </a>
        </div>

        <div class="max-w-3xl mx-auto bg-white rounded-3xl shadow-md border border-gray-200 overflow-hidden">
            
            <div class="p-8 border-b border-gray-100 flex flex-col md:flex-row items-center gap-6 bg-gradient-to-r from-white to-gray-50">
                <div class="w-32 h-32 rounded-full overflow-hidden border-4 border-[#077A7D] shadow-sm shrink-0">
                    <img 
                        src="{{ url_for('static', filename='uploads/' + Profile.Profile_picture) if Profile.Profile_picture != 'default' else '/static/profile.jpg' }}" 
                        class="w-full h-full object-cover"
                        alt="Profile Picture"
                    >
                </div>
                <div class="text-center md:text-left flex-1">
                    <h1 class="font-bold text-3xl mb-1">{{ Profile.Profile_name }}</h1>
                    <p class="text-[#077A7D] font-medium text-sm mb-4">{{ User_Email }}</p>
                    
                    <h3 class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-2">Current Interests:</h3>
                    <div class="flex flex-wrap justify-center md:justify-start gap-2">
                        {% for interest in Interests %}
                            <span class="text-xs bg-[#077A7D]/10 text-[#077A7D] font-semibold px-3 py-1 rounded-full border border-[#077A7D]/20">
                                {{ interest.name }}
                            </span>
                        {% else %}
                            <span class="text-xs bg-gray-100 text-gray-400 italic px-3 py-1 rounded-full">
                                No listed interests
                            </span>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="p-8 border-b border-gray-100">
                <h2 class="font-bold text-lg mb-3 text-gray-800">About the Artist</h2>
                <p class="text-gray-600 leading-relaxed whitespace-pre-line">{{ Profile.description }}</p>
            </div>

            <div class="p-8 bg-gray-50/50">
                <h2 class="font-bold text-lg mb-4 text-gray-800">Discography / Showcase</h2>
                {% if Songs %}
                    <div class="space-y-4">
                        {% for song in Songs %}
                            <div class="bg-white border border-gray-200 rounded-2xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-sm">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 bg-zinc-800 rounded-full flex items-center justify-center text-white text-xs font-bold border-2 border-zinc-700 animate-spin-slow shadow shrink-0">
                                        💿
                                    </div>
                                    <p class="font-semibold text-sm text-gray-800 flex-1">{{ song.Song_name }}</p>
                                </div>
                                <div class="w-full sm:w-auto sm:max-w-xs flex-1">
                                    <audio controls class="w-full h-10">
                                        <source src="{{ url_for('static', filename='uploads/' + song.Song_file) }}" type="audio/mpeg">
                                    </audio>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center py-8 bg-white rounded-2xl border border-dashed border-gray-200 text-gray-400 text-sm italic">
                        This artist hasn't uploaded any showcase tracks yet.
                    </div>
                {% endif %}
            </div>

            <div class="p-6 bg-white border-t border-gray-100 flex justify-center gap-4">
                <form action="/invites/{{ Profile.User_ID }}/decline" method="POST">
                    <button type="submit" class="px-6 py-2.5 rounded-full border-2 border-gray-300 text-gray-600 font-bold text-sm hover:bg-gray-100 transition-all">
                        Decline Invite
                    </button>
                </form>

                <form action="/invites/{{ Profile.User_ID }}/accept" method="POST">
                    <button type="submit" class="px-8 py-2.5 rounded-full bg-[#077A7D] text-white font-bold text-sm hover:bg-[#055a5c] transition-all shadow-sm">
                        Accept Invitation
                </form>
            </div>

        </div>
    </main>

</body>
</html>